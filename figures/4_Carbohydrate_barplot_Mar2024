import pandas as pd
import numpy as np
import matplotlib.pyplot as plt

# --------------------------
# 1) Load data
# --------------------------
file_path = "Carb_RA_PR_PR2_Pump_trimmed.csv" 
df = pd.read_csv(file_path)

# --------------------------
# 2) Filter to PR2 + remove excluded samples
# --------------------------
df_sub = df[df["Experiment_Cruise"] == "PR2"].copy()

# Remove Water Depth == "Meso Filtered"
# (Assumes the column name is exactly "Water Depth")
df_sub = df_sub[df_sub["Water Depth"] != "Meso Filtered"]

# Remove Control treatment
# (Assumes the column name is exactly "Water_Treatment")
df_sub = df_sub[df_sub["Water_Treatment"] != "Control"]

# --------------------------
# 3) Identify carbohydrate columns (last 9 columns)
# --------------------------
carb_cols = df_sub.columns[-9:].tolist()

# --------------------------
# 4) Aggregate + normalize
# --------------------------
# Mean composition per Water_Treatment x Timepoint
df_grouped = (
    df_sub
    .groupby(["Water_Treatment", "Timepoint"], as_index=False)[carb_cols]
    .mean()
)

# Order timepoints
df_grouped["Timepoint"] = pd.Categorical(
    df_grouped["Timepoint"], categories=["T0", "TF"], ordered=True
)

# Strict normalization to 100% per bar (sum to 1.0)
row_sums = df_grouped[carb_cols].sum(axis=1)
df_grouped.loc[row_sums > 0, carb_cols] = df_grouped.loc[row_sums > 0, carb_cols].div(
    row_sums[row_sums > 0], axis=0
)

# Match the same treatment ordering used previously (drops any that aren’t present)
treatment_order = ["UE_EP", "M_EP", "UE_MP", "M_MP"]
present = [t for t in treatment_order if t in df_grouped["Water_Treatment"].unique()]

df_grouped["Water_Treatment"] = pd.Categorical(
    df_grouped["Water_Treatment"], categories=present, ordered=True
)
df_grouped = df_grouped.sort_values(["Water_Treatment", "Timepoint"])

# --------------------------
# 5) Colors (exact palette)
# --------------------------
custom_palette = [
    "#335c67",
    "#99a88c",
    "#fff3b0",
    "#f0c977",
    "#e09f3e",
    "#bf6535",
    "#9e2a2b",
    "#791b1d",
    "#540b0e"
]

# --------------------------
# 6) Plot
# --------------------------
treatments = present
x = np.arange(len(treatments))
bar_width = 0.35

fig, ax = plt.subplots(figsize=(6, 4))

for tp_index, timepoint in enumerate(["T0", "TF"]):
    subset = df_grouped[df_grouped["Timepoint"] == timepoint]
    bottoms = np.zeros(len(treatments))

    for i, carb in enumerate(carb_cols):
        values = []
        for tr in treatments:
            s = subset.loc[subset["Water_Treatment"] == tr, carb]
            values.append(float(s.values[0]) if len(s) else 0.0)

        ax.bar(
            x + (tp_index - 0.5) * bar_width,
            values,
            bar_width,
            bottom=bottoms,
            color=custom_palette[i],
            linewidth=0,       # no borders
            edgecolor=None
        )
        bottoms += np.array(values)

# Minimalist styling
ax.set_xticks(x)
ax.set_xticklabels(treatments, fontsize=10)
ax.set_ylabel("Relative Abundance", fontsize=11)
ax.set_ylim(0, 1)

ax.spines["top"].set_visible(False)
ax.spines["right"].set_visible(False)
ax.tick_params(axis="both", which="major", labelsize=9)

# NOTE: Legend omitted in the exported PDF to match the exact file I generated.
# If you want the legend back, uncomment the block below:
# ax.legend(frameon=False, bbox_to_anchor=(1.02, 1), loc="upper left", fontsize=8)

plt.tight_layout()

# --------------------------
# 7) Export high-quality vector PDF
# --------------------------
out_pdf = "Carbohydrate_Composition_PR2_minimalist_high_quality.pdf"
plt.savefig(out_pdf, format="pdf", bbox_inches="tight")
plt.close()

print(f"Saved: {out_pdf}")
